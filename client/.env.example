# Client environment variables
# All values here are placeholders. Copy to .env.local and fill real values.

# --- App meta ---
VITE_APP_NAME=CiviServe
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0
VITE_DEFAULT_LANGUAGE=en

# --- API ---
# Base URL of the FastAPI backend. In dev, Vite proxies /api -> localhost:8000,
# so this can stay empty locally.
VITE_API_BASE_URL=

# --- Firebase Authentication (web app config from Firebase console) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Maps ---
# Provider: "osm" (OpenStreetMap + Leaflet, no key) | "google"
VITE_MAPS_PROVIDER=osm
VITE_MAPS_API_KEY=

# --- Speech engine selection (adapter switch-points) ---
# "browser" uses the Web Speech API (MVP). Future: "google", "azure"
VITE_STT_ENGINE=browser
VITE_TTS_ENGINE=browser
VITE_ENABLE_VOICE=true

# --- Translation ---
# Server always tries IndicTrans2 first. This flag enables the Google Translate
# fallback path on the server.
VITE_TRANSLATION_FALLBACK_ENABLED=true

# --- OCR ---
# "tesseract" (runs in-browser) | future: "paddle" (server)
VITE_OCR_ENGINE=tesseract
VITE_ENABLE_OCR=false

# --- Feature flags ---
VITE_GEOLOCATION_ENABLED=true
VITE_ENABLE_HISTORY=true
