# Database-only tooling env. Copy to database/.env for migration/seed scripts.
# Var names match server/.env.example so a single set can drive both when convenient.

DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech:5432/neondb?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false