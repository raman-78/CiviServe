# Server environment variables. Copy to .env and fill real values.

# --- App ---
ENV=development                        # development | staging | production
DEBUG=true
APP_NAME=civiserve-server
VERSION=0.1.0
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# --- Database (Neon PostgreSQL) ---
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civiserve
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# --- Redis (rate limiting + cache + queues). Optional for MVP. ---
REDIS_URL=redis://localhost:6379/0

# --- Firebase Authentication ---
# Path to the service-account JSON (never commit it). On Railway/Render use
# FIREBASE_SERVICE_ACCOUNT_JSON with the raw contents instead.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Gemini (AI) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30
# Cache Gemini responses keyed by (profile hash + query hash) to control cost.
GEMINI_CACHE_ENABLED=true
GEMINI_CACHE_TTL_SECONDS=86400
# Retry config: re-attempt the provider call up to N times with a backoff.
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_MIN_DELAY_SECONDS=0.8

# --- AI chat pipeline ---
RAG_TOP_K=6
CHAT_CONTEXT_MESSAGE_LIMIT=30
CHAT_CONTEXT_MAX_CHARS=6000
CHAT_AUTO_TITLE_MAX_CHARS=50

# --- Translation: IndicTrans2 preferred, Google Translate fallback ---
# Provider selection: auto | google | indictrans | identity.
#   auto      -> IndicTrans2 when enabled, else Google when a key is set, else identity.
#   identity  -> passthrough (no external service; useful for offline dev/tests).
TRANSLATION_PROVIDER=auto
INDICTRANS_ENABLED=false
INDICTRANS_ENDPOINT=http://localhost:8100/translate
INDICTRANS_MODEL_DIR=/models/indic-trans
GOOGLE_TRANSLATE_API_KEY=
# Maximum language pairs kept in the translation cache.
TRANSLATION_CACHE_TTL_SECONDS=604800

# --- Speech (future cloud STT/TTS; MVP uses browser Web Speech) ---
GOOGLE_SPEECH_LANGUAGE_HINT=hi-IN

# --- Documents (Prompt 11) ---
# Private storage root for uploaded documents (never served statically).
DOCUMENT_STORAGE_DIR=storage/documents
# Maximum upload size in bytes.
DOCUMENT_MAX_SIZE_BYTES=10485760
# Allowed file extensions, comma-separated.
DOCUMENT_ACCEPTED_FORMATS=pdf,jpg,jpeg,png
DOCUMENT_STORE_CHECKSUM=true

# --- OCR (future server-side PaddleOCR; MVP uses browser tesseract.js) ---
PADDLEOCR_ENDPOINT=

# --- Storage (voice clips, OCR images — Google Cloud Storage, optional) ---
GCS_BUCKET=

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Rate limiting (per user/IP) ---
RATE_LIMIT_MAX_PER_MINUTE=60
RATE_LIMIT_MAX_PER_USER_PER_HOUR=300
AI_ENDPOINT_RATE_LIMIT_MAX_PER_MINUTE=20

# --- Security ---
# Comma-separated list of request paths that never touch AI (e.g. health checks).
NO_AI_PATH_PREFIXES=/healthz,/metrics
